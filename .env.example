# Copy to .env.local and add your ElevenLabs API key (used by `npm run audio`).
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# OPTIONAL — enables on-the-fly generation for any text that has no pre-generated MP3.
# WARNING: VITE_ variables are bundled into the browser build and visible to anyone. Dev use only.
# VITE_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
